# ─── LLM (OpenAI-compatible — OpenRouter) ────────────────────
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model id. Free + tool-capable default below.
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free

# ─── Twilio WhatsApp ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox sender (Twilio gives you this). Format: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Google Sheets (optional — CSV works without this) ───────
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# ─── App ─────────────────────────────────────────────────────
RETAILMIND_CONFIG=./config/retailers.yaml
APP_BASE_URL=http://localhost:8000
TWILIO_VALIDATE_SIGNATURE=false
