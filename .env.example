# LLM (Groq — OpenAI-compatible endpoint; get a key at https://console.groq.com)
LLM_API_KEY=your_groq_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Wuzapi (WhatsApp gateway — local Docker by default)
# WUZAPI_TOKEN is the per-user token from Wuzapi's admin panel after pairing your number
WUZAPI_API_URL=http://localhost:8080
WUZAPI_TOKEN=your_wuzapi_user_token

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Google OAuth (for retailer Google Sheet connection)
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Google API key for the Picker widget (Cloud Console -> Credentials -> Create API key, restrict to Picker API)
GOOGLE_API_KEY=your_google_api_key

# Google Sheets service account (local dev fallback)
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# App
APP_BASE_URL=http://localhost:8000
RETAILMIND_CONFIG=./config/retailers.yaml
