# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Narrator/agent model. Sonnet 4.6 is the cost/latency default for the loop.
# Use claude-opus-4-7 for the narrator if you want max prose quality.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Twilio WhatsApp ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox sender (Twilio gives you this). Format: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Google Sheets (optional — CSV works without this) ───────
# Path to the service-account JSON. Share the target sheet with the
# service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# ─── App ─────────────────────────────────────────────────────
RETAILMIND_CONFIG=./config/retailers.yaml
APP_BASE_URL=http://localhost:8000
# Comma-free single value. Used to verify Twilio inbound webhooks (optional).
TWILIO_VALIDATE_SIGNATURE=false
